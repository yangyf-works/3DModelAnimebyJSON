{
  "definitions": {
    "WorkCube": {
      "type": "mesh",
      "file": "cube.ply",
      "transform": {
        "scale": [0.5, 0.8, 0.2]
      }

    },
    "cube": {
      "type": "mesh",
      "file": "cube.ply"
    },
    "sphere": {
      "type": "mesh",
      "file": "sphere.ply"
    },
    "cylinder": {
      "type": "mesh",
      "file": "cylinder.ply"
    },

    "arraytest":{
      "type": "array",
      "mode": "line",
      "ref": "WorkCube",

      "count": 10,
      "spacing": 1.5,

      "direction": [1, 0, 0],
      "start": [0, 0, 0],

      "align_to_path": false,

      "transform": {
        "scale": [0.3, 0.3, 0.3]
      }
    },
    "pallets":{
      "type": "array",
      "mode": "arc",
      "ref": "WorkCube",

      "count": 15,

      "center": [0, 0, 0],
      "radius": 5,

      "start_angle": 90,
      "end_angle": 240,

      "axis": [0, 1, 0],
      "align_to_path": true
    },

    "stocker":{
      "type": "array",
      "mode": "line",
      "ref": "pallets",

      "count": 4,
      "spacing": 2,

      "direction": [0, 1, 0],
      "start": [0, 0, 0],

      "align_to_path": false
    },
    "WSS": {
      "type": "node",
      "children": [
        {
          "ref": "WorkCube",
          "transform": {
            "position": [0.0, 3, 0]
          }
        },
        {
          "ref": "WorkCube",
          "transform": {
            "position": [0.0, 2, 0]
          }
        },
        {
          "ref": "WorkCube",
          "transform": {
            "position": [0.0, 0, 0]
          }
        }
      ]
    },
    "WSSs":{
      "type": "array",
      "mode": "arc",
      "ref": "WSS",

      "count": 3,

      "center": [0, 0, 0],
      "radius": 4,

      "start_angle": 260,
      "end_angle": 280,

      "axis": [0, 1, 0],
      "align_to_path": true
    },

    "WPS": {
      "type": "node",
      "children": [
        {
          "ref": "cylinder",
          "transform": {
            "scale": [0.1, 5, 0.1],
            "position": [0, 1, 0]
          }
        },
        {
          "ref": "WorkCube",
          "transform": {
            "scale": [0.1, 1, 0.1],
            "position": [0.9, 0, 0.4]
          }
        }
      ]
    },
    "table": {
      "type": "node",
      "children": [
        {
          "ref": "cylinder",
          "transform": {
            "scale": [2, 0.5, 2],
            "position": [0, 0, 0]
          }
        }
      ],
      "joint": {
        "type": "linear",
        "axis": [0,0,1]
      }
    },
    "WPSarmsubsub": {
      "type": "node",
      "children": [
        {
          "ref": "cube",
          "transform": {
            "scale": [3, 0.3, 0.3]
          }
        }
      ],
      "joint": {
        "type": "linear",
        "axis": [1, 0, 0]
      }
    },
    "WPSarmsub": {
      "type": "node",
      "children": [
        {
          "ref": "cube",
          "transform": {
            "scale": [3, 0.5, 0.5],
            "position": [-1.5, 5, 0]
          }
        },
        {
          "ref": "WPSarmsubsub",
          "transform": {
            "position": [-4.5, 5, 0]
          }
        }
      ],
      "joint": {
        "type": "linear",
        "axis": [1, 0, 0]
      }
    },
    "WPSarmsubWH": {
      "type": "node",
      "children": [
        {
          "ref": "WPSarmsub"
        }
      ],
      "joint": {
        "type": "linear",
        "axis": [0, 1, 0]
      }
    },
    "WPSarm": {
      "type": "node",
      "children": [
        {
          "ref": "cylinder",
          "transform": {
            "scale": [0.5, 8, 0.5],
            "position": [0, 4, 0]
          }
        },
        {
          "ref": "WPSarmsubWH"
        }
      ],
      "joint": {
        "type": "rotate",
        "pivot":[0, 0, 0],
        "axis": [0, 1, 0]
      }
    }
  },

  "scene": [
    {
      "ref": "WSSs",
      "transform": {
        "position": [0, 1, 0]
      }
    },
    {
      "ref": "stocker",
      "transform": {
        "position": [0, 0, 0]
      }
    },
    {
      "ref": "table",
      "transform": {
        "position": [6, 0, 0]
      }
    },
    {
      "ref": "WPSarm"
    }
  ]
}